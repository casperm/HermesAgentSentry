# ==============================================================================
# Hermes Agent Secure Stack - Environment Configuration Template
# Copy this file to '.env' and fill in your credentials:
#   cp .env.example .env
# ==============================================================================

# ── Ingress Settings ──────────────────────────────────────────────────────────
# The Cloudflare Tunnel token that connects your public hostname to this stack.
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# ── AWS Bedrock Credentials ───────────────────────────────────────────────────
# Optional: Required if using Amazon Bedrock models (e.g., Claude 3.5 Sonnet).
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=default

# ── Web Search Provider Keys ──────────────────────────────────────────────────
# Optional: Enabled to let the agent search the web and perform live research.
BRAVE_API_KEY=your_brave_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# ── Inference Providers ──────────────────────────────────────────────────────
# Optional: DeepInfra API key to leverage hosted open-weight models.
DEEPINFRA_API_KEY=your_deepinfra_api_key_here

# ── Permissions (Optional) ──────────────────────────────────────────────────
# Set user/group IDs to match your remote Linux host user to avoid Permission Denied errors.
# HERMES_UID=1000
# HERMES_GID=1000

